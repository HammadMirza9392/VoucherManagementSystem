@model VoucherManagementSystem.Models.Note
@{
    ViewData["Title"] = Model.Title;
    var canModify = ViewBag.CanModify != null && (bool)ViewBag.CanModify;
}

<div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
    <h4><i class="bi bi-journal-text"></i> Note Details</h4>
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Back to Note Book
    </a>
</div>

<div class="card shadow-sm" style="max-width: 900px;">
    <div class="card-header @(Model.IsPinned ? "bg-warning-subtle" : "bg-dark text-white")">
        <h5 class="mb-0 text-break">
            @if (Model.IsPinned)
            {
                <i class="bi bi-pin-angle-fill text-warning me-1"></i>
            }
            @Model.Title
        </h5>
    </div>
    <div class="card-body">
        <p class="text-break mb-0" style="white-space: pre-wrap;">@Model.Description</p>
    </div>
    <div class="card-footer bg-white small text-muted">
        <i class="bi bi-person"></i> Written by <strong>@(Model.CreatedBy ?? "-")</strong>
        on @Model.CreatedDate.ToPkDateTime()
        @if (Model.LastUpdated.HasValue)
        {
            <br />
            <i class="bi bi-pencil"></i>
            <span>Last edited by <strong>@(Model.UpdatedBy ?? "-")</strong> on @Model.LastUpdated.ToPkDateTime()</span>
        }
    </div>
</div>

<div class="mt-3 d-print-none">
    @if (canModify)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('Delete this note?')">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Delete
            </button>
        </form>
    }
    <button onclick="window.print()" class="btn btn-primary">
        <i class="bi bi-printer"></i> Print
    </button>
</div>
