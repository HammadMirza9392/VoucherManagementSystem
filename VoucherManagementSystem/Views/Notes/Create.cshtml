@model VoucherManagementSystem.Models.Note
@{
    ViewData["Title"] = "Add Note";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-journal-plus"></i> Add Note</h4>
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="card shadow-sm" style="max-width: 800px;">
    <div class="card-body">
        <form asp-action="Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold">Title <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="Short title for this note" autofocus />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Description <span class="text-danger">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="10"
                          placeholder="Write the full details here..."></textarea>
                <div class="form-text text-muted">Line breaks are kept exactly as you type them.</div>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="IsPinned" class="form-check-input" type="checkbox" />
                    <label asp-for="IsPinned" class="form-check-label">Pin this note to the top</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Save Note
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
