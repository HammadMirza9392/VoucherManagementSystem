@* Views/Reports/AllProjectsReport.cshtml - All Projects Report *@
@using VoucherManagementSystem.Controllers
@{
    ViewData["Title"] = "All Projects Report";
    var projectReports = ViewBag.ProjectReports as List<ProjectReportItem>;
    var fromDate = (DateTime)ViewBag.FromDate;
    var toDate = (DateTime)ViewBag.ToDate;
    var totalRevenue = (decimal)(ViewBag.TotalRevenue ?? 0);
    var totalPurchases = (decimal)(ViewBag.TotalPurchases ?? 0);
    var totalExpenses = (decimal)(ViewBag.TotalExpenses ?? 0);
    var totalProfitLoss = (decimal)(ViewBag.TotalProfitLoss ?? 0);
}

<div class="d-print-none">
    <h2><i class="bi bi-diagram-3"></i> All Projects Report</h2>
    <p class="text-muted">Overview of all projects performance</p>
</div>

<!-- Title shown only in print / PDF (the heading above is screen-only) -->
<div class="d-none d-print-block pdf-title mb-3">
    <h3 class="mb-0"><i class="bi bi-diagram-3"></i> All Projects Report</h3>
    <small>Period: @fromDate.ToString("dd-MMM-yyyy") to @toDate.ToString("dd-MMM-yyyy")</small>
</div>

<!-- Filter Form -->
<div class="card mb-3 d-print-none">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="bi bi-filter"></i> Filter Options</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">From Date</label>
                <input type="date" name="fromDate" value="@fromDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">To Date</label>
                <input type="date" name="toDate" value="@toDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-info w-100">
                    <i class="bi bi-search"></i> Generate
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-3">
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <h6>Total Revenue (Sale + Stock)</h6>
                <h4>Rs. @string.Format("{0:N0}", totalRevenue)</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <h6>Total Purchases</h6>
                <h4>Rs. @string.Format("{0:N0}", totalPurchases)</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-danger text-white">
            <div class="card-body text-center">
                <h6>Total Expenses</h6>
                <h4>Rs. @string.Format("{0:N0}", totalExpenses)</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-@(totalProfitLoss >= 0 ? "success" : "danger") text-white">
            <div class="card-body text-center">
                <h6>Net Profit/Loss</h6>
                <h4>Rs. @string.Format("{0:N0}", totalProfitLoss)</h4>
            </div>
        </div>
    </div>
</div>

<!-- Projects Table -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-table"></i> Project Details (@fromDate.ToString("dd-MMM-yyyy") to @toDate.ToString("dd-MMM-yyyy"))</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="projectsTable">
                <thead class="table-dark">
                    <tr>
                        <th>Project Name</th>
                        <th class="text-center">Vouchers</th>
                        <th class="text-end">Revenue (Sale + Stock)</th>
                        <th class="text-end">Purchases</th>
                        <th class="text-end">Expenses</th>
                        <th class="text-end">Profit/Loss</th>
                        <th class="text-center d-print-none">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (projectReports != null && projectReports.Any())
                    {
                        foreach (var p in projectReports)
                        {
                            <tr>
                                <td>
                                    <strong>@p.Project.Name</strong>
                                    @if (!string.IsNullOrEmpty(p.Project.Description))
                                    {
                                        <br /><small class="text-muted">@p.Project.Description</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@p.VoucherCount</span>
                                </td>
                                <td class="text-end text-success">Rs. @string.Format("{0:N0}", p.Revenue)</td>
                                <td class="text-end text-primary">Rs. @string.Format("{0:N0}", p.Purchases)</td>
                                <td class="text-end text-danger">Rs. @string.Format("{0:N0}", p.Expenses)</td>
                                <td class="text-end fw-bold @(p.ProfitLoss >= 0 ? "text-success" : "text-danger")">
                                    Rs. @string.Format("{0:N0}", p.ProfitLoss)
                                </td>
                                <td class="text-center d-print-none">
                                    <a asp-action="ProjectReport" asp-route-projectId="@p.Project.Id" asp-route-fromDate="@fromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@toDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">No projects found.</td>
                        </tr>
                    }
                </tbody>
                @if (projectReports != null && projectReports.Any())
                {
                    <tfoot class="table-dark">
                        <tr>
                            <th>Total</th>
                            <th class="text-center">@projectReports.Sum(p => p.VoucherCount)</th>
                            <th class="text-end">Rs. @string.Format("{0:N0}", totalRevenue)</th>
                            <th class="text-end">Rs. @string.Format("{0:N0}", totalPurchases)</th>
                            <th class="text-end">Rs. @string.Format("{0:N0}", totalExpenses)</th>
                            <th class="text-end">Rs. @string.Format("{0:N0}", totalProfitLoss)</th>
                            <th class="d-print-none"></th>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

<div class="mt-3 d-print-none">
    <button onclick="window.print()" class="btn btn-primary">
        <i class="bi bi-printer"></i> Print
    </button>
    <button onclick="generatePDF()" class="btn btn-danger"
            data-from-date="@fromDate.ToString("yyyyMMdd")" data-to-date="@toDate.ToString("yyyyMMdd")">
        <i class="bi bi-file-pdf"></i> Generate PDF
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Reports
    </a>
</div>

@section Scripts {
    <!-- html2pdf.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        // Builds a clean clone of just the report (no navbar/footer/filter/buttons/Action column),
        // expanded so html2pdf captures every row and every column.
        function buildPdfElement() {
            const element = document.querySelector('body').cloneNode(true);
            element.style.display = 'block';
            element.style.height = 'auto';

            // Strip site chrome and screen-only controls (filter form, buttons, Action column)
            element.querySelectorAll('header, footer, .modal, .d-print-none')
                   .forEach(el => el.remove());

            // Show the print-only title
            element.querySelectorAll('.pdf-title').forEach(el => el.classList.remove('d-none'));

            element.querySelectorAll('.table-responsive').forEach(function(el) {
                el.style.maxHeight = 'none';
                el.style.overflow = 'visible';
            });

            element.querySelectorAll('#projectsTable thead').forEach(t => t.style.display = 'table-header-group');
            element.querySelectorAll('#projectsTable tfoot').forEach(t => t.style.display = 'table-footer-group');

            // Columns: Project Name, Vouchers, Revenue, Purchases, Expenses, Profit/Loss
            const colWidths = ['26%', '9%', '17%', '16%', '15%', '17%'];
            element.querySelectorAll('#projectsTable').forEach(function(tbl) {
                tbl.style.width = '100%';
                tbl.style.tableLayout = 'fixed';
                const colgroup = document.createElement('colgroup');
                colWidths.forEach(function(w) {
                    const col = document.createElement('col');
                    col.style.width = w;
                    colgroup.appendChild(col);
                });
                tbl.insertBefore(colgroup, tbl.firstChild);
            });

            element.querySelectorAll('#projectsTable th, #projectsTable td').forEach(function(cell) {
                cell.style.wordBreak = 'break-word';
                cell.style.whiteSpace = 'normal';
                cell.style.fontSize = '11px';
                cell.style.padding = '5px 6px';
                cell.style.verticalAlign = 'middle';
            });

            return element;
        }

        function generatePDF() {
            const button = event.target.closest('button');
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="bi bi-hourglass-split"></i> Generating PDF...';
            button.disabled = true;

            const f = button.getAttribute('data-from-date') || '';
            const t = button.getAttribute('data-to-date') || '';
            const filename = 'AllProjectsReport_' + f + '_' + t + '.pdf';

            const element = buildPdfElement();
            const opt = {
                margin: [10, 10, 10, 10],
                filename: filename,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true, logging: false, scrollY: 0, scrollX: 0, windowHeight: element.scrollHeight },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' },
                pagebreak: { mode: ['css', 'legacy'], avoid: 'tr' }
            };

            html2pdf().set(opt).from(element).save().then(function() {
                button.innerHTML = originalText;
                button.disabled = false;
            }).catch(function(error) {
                console.error('PDF generation error:', error);
                button.innerHTML = originalText;
                button.disabled = false;
            });
        }
    </script>
}
