@model VoucherManagementSystem.Models.Note
@{
    ViewData["Title"] = "Edit Note";
}

@section Styles {
    <style>
        .nb-form-wrap {
            max-width: 820px;
            margin: 0 auto;
        }

        .nb-form-head {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            margin-bottom: 1rem;
        }

        .nb-form-head h4 {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin: 0;
            font-size: clamp(1.1rem, 1rem + .8vw, 1.5rem);
            font-weight: 600;
            color: var(--text-color);
        }

        .nb-form-head h4 .bi {
            color: var(--primary-color);
        }

        .nb-card {
            background: var(--card-background);
            color: var(--text-color);
            border: 1px solid rgba(128, 128, 128, .18);
            border-radius: 14px;
            padding: 1.25rem;
        }

        .nb-label {
            font-weight: 600;
            font-size: .85rem;
            margin-bottom: .35rem;
        }

        .nb-card .form-control {
            border-radius: 10px;
            min-height: 44px;
        }

        .nb-card textarea.form-control {
            min-height: 220px;
            line-height: 1.6;
            resize: vertical;
        }

        .nb-counter {
            font-size: .75rem;
            opacity: .65;
        }

        .nb-pin-box {
            display: flex;
            align-items: center;
            gap: .6rem;
            padding: .75rem 1rem;
            border: 1px solid rgba(128, 128, 128, .2);
            border-radius: 10px;
            background: color-mix(in srgb, var(--warning-color) 8%, transparent);
        }

        .nb-trail {
            margin-top: 1rem;
            padding: .75rem 1rem;
            border-radius: 10px;
            border: 1px solid rgba(128, 128, 128, .18);
            font-size: .8rem;
            opacity: .8;
            display: flex;
            flex-wrap: wrap;
            gap: .25rem 1rem;
        }

        .nb-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            margin-top: 1.25rem;
        }

        .nb-actions .btn {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

        @@media (max-width: 575.98px) {
            .nb-card {
                padding: 1rem;
                border-radius: 12px;
            }

            .nb-card textarea.form-control {
                min-height: 180px;
            }

            .nb-actions .btn {
                flex: 1 1 100%;
                justify-content: center;
            }

            .nb-form-head .btn-back {
                width: 100%;
            }
        }
    </style>
}

<div class="nb-form-wrap">
    <div class="nb-form-head">
        <h4><i class="bi bi-pencil-square"></i> Edit Note</h4>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm btn-back">
            <i class="bi bi-arrow-left"></i> Back to Note Book
        </a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" class="nb-card">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label nb-label">
                Title <span class="text-danger">*</span>
            </label>
            <input asp-for="Title" class="form-control" maxlength="200" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-end">
                <label asp-for="Description" class="form-label nb-label">
                    Description <span class="text-danger">*</span>
                </label>
                <span class="nb-counter"><span id="descCount">0</span> / 5000</span>
            </div>
            <textarea asp-for="Description" class="form-control" rows="10" maxlength="5000"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <label class="nb-pin-box">
            <input asp-for="IsPinned" class="form-check-input mt-0" type="checkbox" />
            <span>
                <span class="fw-semibold d-block">Pin to top</span>
                <span class="small opacity-75">Pinned notes always appear first in the list.</span>
            </span>
        </label>

        <div class="nb-trail">
            <span><i class="bi bi-person"></i> Written by <strong>@(Model.CreatedBy ?? "Unknown")</strong> on @Model.CreatedDate.ToPkDateTime()</span>
            @if (Model.LastUpdated.HasValue)
            {
                <span><i class="bi bi-pencil"></i> Last edited by <strong>@(Model.UpdatedBy ?? "Unknown")</strong> on @Model.LastUpdated.ToPkDateTime()</span>
            }
        </div>

        <div class="nb-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> Update Note
            </button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var box = document.getElementById('Description');
            var out = document.getElementById('descCount');
            if (!box || !out) return;
            var update = function () { out.textContent = box.value.length; };
            box.addEventListener('input', update);
            update();
        })();
    </script>
}
