@model IEnumerable<VoucherManagementSystem.Models.Note>
@{
    ViewData["Title"] = "Note Book";
    var search = ViewBag.Search as string;
    var currentUser = ViewBag.CurrentUser as string ?? "";
    var isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
    var notes = Model.ToList();
    var pinnedCount = notes.Count(n => n.IsPinned);
    var mineCount = notes.Count(n => string.Equals(n.CreatedBy, currentUser, StringComparison.OrdinalIgnoreCase));
    var isSearching = !string.IsNullOrWhiteSpace(search);
}

@section Styles {
    <style>
        /* ---------- Page header ---------- */
        .nb-page {
            max-width: 1280px;
            margin: 0 auto;
            padding-top: 1.75rem;
        }

        .nb-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding-bottom: 1rem;
            margin-bottom: 1.25rem;
            border-bottom: 1px solid rgba(128, 128, 128, .18);
        }

        .nb-head-left {
            display: flex;
            align-items: center;
            gap: .85rem;
            min-width: 0;
        }

        .nb-head-icon {
            flex: 0 0 auto;
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-size: 1.35rem;
            color: var(--primary-color);
            background: color-mix(in srgb, var(--primary-color) 12%, transparent);
        }

        .nb-head-text h4 {
            margin: 0;
            font-size: clamp(1.15rem, 1rem + .9vw, 1.5rem);
            font-weight: 600;
            line-height: 1.2;
            color: var(--text-color);
        }

        .nb-head-text p {
            margin: .15rem 0 0;
            font-size: .85rem;
            opacity: .65;
        }

        .nb-stats {
            display: flex;
            flex-wrap: wrap;
            gap: .4rem;
            margin-bottom: 1rem;
        }

        .nb-chip {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .3rem .7rem;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 500;
            line-height: 1;
            border: 1px solid rgba(128, 128, 128, .22);
            background: var(--card-background);
            color: var(--text-color);
            white-space: nowrap;
        }

        .nb-chip i {
            font-size: .85rem;
            opacity: .7;
        }

        .nb-chip strong {
            font-weight: 600;
        }

        .nb-chip.is-pin {
            border-color: color-mix(in srgb, var(--warning-color) 45%, transparent);
            background: color-mix(in srgb, var(--warning-color) 10%, transparent);
        }

        .nb-chip.is-pin i {
            color: var(--warning-color);
            opacity: 1;
        }

        /* ---------- Search ---------- */
        .nb-search {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            margin-bottom: 1.25rem;
        }

        .nb-search .input-group {
            flex: 1 1 260px;
            min-width: 0;
        }

        .nb-search .form-control,
        .nb-search .input-group-text {
            min-height: 44px;
            border-color: rgba(128, 128, 128, .25);
        }

        .nb-search .btn {
            min-height: 44px;
            padding-inline: 1.5rem;
        }

        /* ---------- Note grid ---------- */
        .nb-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
            gap: 1rem;
            align-items: start;
        }

        .nb-card {
            display: flex;
            flex-direction: column;
            background: var(--card-background);
            color: var(--text-color);
            border: 1px solid rgba(128, 128, 128, .18);
            border-radius: 14px;
            overflow: hidden;
            transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
        }

        .nb-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .6rem 1.4rem rgba(0, 0, 0, .10);
            border-color: color-mix(in srgb, var(--primary-color) 35%, transparent);
        }

        .nb-card.is-pinned {
            border-color: color-mix(in srgb, var(--warning-color) 55%, transparent);
        }

        .nb-card.is-pinned::before {
            content: "";
            display: block;
            height: 4px;
            background: var(--warning-color);
        }

        .nb-card-body {
            padding: 1rem 1rem .5rem;
            flex: 1 1 auto;
            min-width: 0;
        }

        .nb-card-title {
            display: flex;
            align-items: flex-start;
            gap: .4rem;
            font-size: 1rem;
            font-weight: 600;
            line-height: 1.35;
            margin: 0 0 .5rem;
            overflow-wrap: anywhere;
        }

        .nb-card-title a {
            color: inherit;
            text-decoration: none;
        }

        .nb-card-title a:hover {
            color: var(--primary-color);
        }

        .nb-text {
            margin: 0;
            font-size: .9rem;
            line-height: 1.6;
            opacity: .85;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            display: -webkit-box;
            -webkit-line-clamp: 6;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .nb-meta {
            display: flex;
            flex-wrap: wrap;
            gap: .25rem .75rem;
            padding: .5rem 1rem;
            font-size: .75rem;
            opacity: .7;
        }

        .nb-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .35rem;
            padding: .6rem 1rem .9rem;
            border-top: 1px solid rgba(128, 128, 128, .15);
        }

        /* Comfortable tap targets on touch screens */
        .nb-actions .btn {
            min-height: 38px;
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            font-size: .8rem;
        }

        /* ---------- Empty state ---------- */
        .nb-empty {
            max-width: 460px;
            margin: 2rem auto;
            padding: 2.25rem 1.5rem;
            text-align: center;
            background: var(--card-background);
            border: 1px solid rgba(128, 128, 128, .18);
            border-radius: 16px;
            color: var(--text-color);
        }

        /* Scoped to the illustration only, so button icons keep their normal size */
        .nb-empty-icon {
            width: 68px;
            height: 68px;
            margin: 0 auto 1rem;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: color-mix(in srgb, var(--primary-color) 10%, transparent);
        }

        .nb-empty-icon i {
            font-size: 1.9rem;
            color: var(--primary-color);
            opacity: .75;
        }

        .nb-empty h6 {
            font-size: 1.05rem;
            font-weight: 600;
            margin-bottom: .35rem;
        }

        .nb-empty p {
            font-size: .88rem;
            opacity: .7;
            margin-bottom: 1.25rem;
        }

        .nb-empty .btn {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

        .nb-empty .btn i {
            font-size: 1rem;
        }

        /* ---------- Small screens ---------- */
        @@media (max-width: 575.98px) {
            .nb-page {
                padding-top: 1rem;
            }

            .nb-header {
                gap: .75rem;
            }

            .nb-header .btn-add {
                width: 100%;
                min-height: 44px;
                justify-content: center;
            }

            .nb-head-icon {
                width: 40px;
                height: 40px;
                font-size: 1.15rem;
            }

            .nb-grid {
                grid-template-columns: 1fr;
                gap: .75rem;
            }

            .nb-search .btn {
                flex: 1 1 auto;
            }

            .nb-actions .btn {
                flex: 1 1 auto;
                justify-content: center;
            }

            .nb-empty {
                margin: 1rem auto;
                padding: 1.75rem 1.25rem;
            }

            .nb-empty .btn {
                width: 100%;
                justify-content: center;
            }
        }

        @@media print {
            .nb-search, .nb-actions, .nb-header .btn-add {
                display: none !important;
            }

            .nb-grid {
                grid-template-columns: 1fr 1fr;
            }

            .nb-text {
                -webkit-line-clamp: unset;
                display: block;
            }
        }
    </style>
}

<div class="nb-page">
    <div class="nb-header">
        <div class="nb-head-left">
            <span class="nb-head-icon"><i class="bi bi-journal-text"></i></span>
            <div class="nb-head-text">
                <h4>Note Book</h4>
                <p>Shared notes for your team. You can edit the notes you write@(isAdmin ? ", and as Admin any note." : ".")</p>
            </div>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-add d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i> Add Note
        </a>
    </div>

    @if (notes.Any())
    {
        <div class="nb-stats">
            <span class="nb-chip"><i class="bi bi-stickies"></i> <strong>@notes.Count</strong> @(notes.Count == 1 ? "note" : "notes")</span>
            @if (pinnedCount > 0)
            {
                <span class="nb-chip is-pin"><i class="bi bi-pin-angle-fill"></i> <strong>@pinnedCount</strong> pinned</span>
            }
            @if (mineCount > 0)
            {
                <span class="nb-chip"><i class="bi bi-person"></i> <strong>@mineCount</strong> by you</span>
            }
            @if (isSearching)
            {
                <span class="nb-chip"><i class="bi bi-funnel"></i> results for "@search"</span>
            }
        </div>
    }

    <form method="get" class="nb-search d-print-none">
        <div class="input-group">
            <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
            <input type="text" name="search" value="@search" class="form-control"
                   placeholder="Search title or description..." aria-label="Search notes" />
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
        @if (isSearching)
        {
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" title="Clear search">
                <i class="bi bi-x-lg"></i> Clear
            </a>
        }
    </form>

    @if (!notes.Any())
    {
        <div class="nb-empty">
            <div class="nb-empty-icon">
                <i class="bi @(isSearching ? "bi-search" : "bi-journal-plus")"></i>
            </div>
            @if (isSearching)
            {
                <h6>No matching notes</h6>
                <p>Nothing contains "@search". Try a different word.</p>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Show all notes
                </a>
            }
            else
            {
                <h6>No notes yet</h6>
                <p>Write the first note for your team.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Add Note
                </a>
            }
        </div>
    }
    else
    {
        <div class="nb-grid">
            @foreach (var note in notes)
            {
                var canModify = isAdmin || string.Equals(note.CreatedBy, currentUser, StringComparison.OrdinalIgnoreCase);
                <article class="nb-card @(note.IsPinned ? "is-pinned" : "")">
                    <div class="nb-card-body">
                        <h6 class="nb-card-title">
                            @if (note.IsPinned)
                            {
                                <i class="bi bi-pin-angle-fill text-warning" title="Pinned"></i>
                            }
                            <a asp-action="Details" asp-route-id="@note.Id">@note.Title</a>
                        </h6>
                        <p class="nb-text">@note.Description</p>
                    </div>

                    <div class="nb-meta">
                        <span><i class="bi bi-person"></i> @(note.CreatedBy ?? "Unknown")</span>
                        <span><i class="bi bi-calendar3"></i> @note.CreatedDate.ToPkDateTime()</span>
                        @if (note.LastUpdated.HasValue)
                        {
                            <span><i class="bi bi-pencil"></i> edited @note.LastUpdated.ToPkDateTime()</span>
                        }
                    </div>

                    <div class="nb-actions d-print-none">
                        <a asp-action="Details" asp-route-id="@note.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i> Read
                        </a>
                        @if (canModify)
                        {
                            <a asp-action="Edit" asp-route-id="@note.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="TogglePin" asp-route-id="@note.Id" method="post" class="d-inline-flex flex-fill">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning w-100"
                                        title="@(note.IsPinned ? "Unpin this note" : "Pin to top")">
                                    <i class="bi @(note.IsPinned ? "bi-pin-fill" : "bi-pin-angle")"></i>
                                    @(note.IsPinned ? "Unpin" : "Pin")
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@note.Id" method="post" class="d-inline-flex"
                                  onsubmit="return confirm('Delete this note? This cannot be undone.')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete note">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>
