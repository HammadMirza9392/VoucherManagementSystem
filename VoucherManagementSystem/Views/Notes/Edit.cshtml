@model VoucherManagementSystem.Models.Note
@{
    ViewData["Title"] = "Edit Note";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-pencil-square"></i> Edit Note</h4>
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="card shadow-sm" style="max-width: 800px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold">Title <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Description <span class="text-danger">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="10"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="IsPinned" class="form-check-input" type="checkbox" />
                    <label asp-for="IsPinned" class="form-check-label">Pin this note to the top</label>
                </div>
            </div>

            <div class="alert alert-light border small mb-3">
                <i class="bi bi-person"></i> Written by <strong>@(Model.CreatedBy ?? "-")</strong>
                on @Model.CreatedDate.ToPkDateTime()
                @if (Model.LastUpdated.HasValue)
                {
                    <br />
                    <i class="bi bi-pencil"></i>
                    <span>Last edited by <strong>@(Model.UpdatedBy ?? "-")</strong> on @Model.LastUpdated.ToPkDateTime()</span>
                }
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Update Note
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
